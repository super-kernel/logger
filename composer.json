{
    "name": "super-kernel/logger",
    "description": "Monolog-backed PSR-3 logger factories and named stdout logging for SuperKernel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4.27 <8.5",
        "monolog/monolog": "^3.12.1",
        "psr/log": "^3.0.2",
        "super-kernel/attribute": "dev-main",
        "super-kernel/contract": "dev-main"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpunit/phpunit": "^13.4.5"
    },
    "autoload": {
        "psr-4": {
            "SuperKernel\\Logger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperKernel\\Logger\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "format": "@php vendor/bin/php-cs-fixer fix --show-progress=bar --no-ansi",
        "format:check": "@php vendor/bin/php-cs-fixer check --show-progress=bar --no-ansi --diff",
        "test": "@php vendor/bin/phpunit"
    }
}
